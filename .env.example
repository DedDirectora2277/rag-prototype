# OpenRouter (читает LiteLLM): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# id моделей с префиксом openrouter/; бесплатные помечены суффиксом :free
CHAT_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
JUDGE_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
LITELLM_MASTER_KEY=sk-rag-proto

# Docker Compose
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5432
LITELLM_PORT=4000
TEI_EMBED_PORT=8081
TEI_RERANK_PORT=8082

# Приложение (app/config.py, префикс RAG_)
RAG_DATABASE_DSN=postgresql://rag:rag@localhost:5432/rag
RAG_LITELLM_URL=http://localhost:4000
RAG_LITELLM_API_KEY=sk-rag-proto
RAG_EMBED_DIM=1024
